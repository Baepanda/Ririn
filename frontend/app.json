{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.goldenstock.jqc34n",
      "infoPlist": {
        "NSCameraUsageDescription": "Pindai QR code barang saat penjualan",
        "NSPhotoLibraryUsageDescription": "Pilih foto barang untuk inventaris"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.goldenstock.jqc34n",
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-camera",
        { "cameraPermission": "Pindai QR code barang saat penjualan" }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pilih foto barang untuk inventaris",
          "cameraPermission": "Ambil foto barang untuk inventaris"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
